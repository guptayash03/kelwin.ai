rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: users can only read/write their own document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Resumes collection: users can only access their own resumes
    match /resumes/{resumeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Jobs collection: users can only access their own jobs
    match /jobs/{jobId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Applications collection: users can read/create/update their own applications
    match /applications/{applicationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if false;

      // Activity logs written by the worker, read-only for the application owner
      match /logs/{logId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/applications/$(applicationId)).data.userId == request.auth.uid;
        allow write: if false;
      }
    }

    // Application queue: read-only for users (created/updated by API routes and Cloud Run worker)
    match /applicationQueue/{queueItemId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Central jobs: any authenticated user can read, only admin SDK writes
    match /centralJobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Saved jobs: users manage their own bookmarks
    match /users/{userId}/savedJobs/{savedJobId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sync runs: internal only
    match /syncRuns/{runId} {
      allow read, write: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
